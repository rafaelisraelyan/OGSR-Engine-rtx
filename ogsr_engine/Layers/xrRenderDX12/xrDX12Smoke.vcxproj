  <!-- Признак прямого вызова msbuild на .vcxproj фиксируется ДО импорта
       Microsoft.Cpp.Default.props: тот выставляет SolutionDir равным
       каталогу проекта. .sln задаёт SolutionDir заранее, поэтому проба
       остаётся пустой и итоговые OutDir/IntDir не меняются. -->
  <PropertyGroup Label="DirectBuildProbe">
    <_DirectBuildSolutionDir Condition="'$(SolutionDir)' == ''">1</_DirectBuildSolutionDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='ReleaseDX12|x64'" Label="Configuration">
